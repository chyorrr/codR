# codR environment
#
# Every variable here is OPTIONAL. With none of them set the arena still runs:
# challenges come from the bundled catalog and progress saves to localStorage.
# Fill these in to add accounts and a shared, persistent leaderboard.

# ── Auth (Clerk) ─────────────────────────────────────────────────────────────
# Without these, players compete as guests and progress stays on their device.
# Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Database (Supabase) ──────────────────────────────────────────────────────
# Run supabase/schema.sql once, then fill these in.
# Dashboard → Project Settings → API

# Project URL and the public anon key. Used for reads (leaderboard, search).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service_role key. Used ONLY in server routes, to write match results and
# profiles. The schema gives the anon key read-only access, so without this key
# nothing can be written — and with it, nothing in the browser can forge a score.
# Never rename this to NEXT_PUBLIC_*; that would ship it to every visitor.
SUPABASE_SERVICE_ROLE_KEY=

# ── SEO ──────────────────────────────────────────────────────────────────────
# Canonical origin used for sitemap, robots and OpenGraph URLs.
# Defaults to https://codr.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=
